OPENAI_API_KEY=replace-me
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local or Render API disk path for the shared Chroma index (ephemeral on free Render).
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Streamlit: base URL of the FastAPI service (no trailing path).
# Local default:
API_BASE_URL=http://127.0.0.1:8000
# On Streamlit Community Cloud, set Secrets to your Render API, e.g.:
# API_BASE_URL=https://your-api.onrender.com
